DRY_RUN=true
LIVE_TRADING=false

# Optional: pin a specific Polymarket event/market slug from the URL after /event/.
POLYMARKET_EVENT_SLUG=
POLYMARKET_MARKET_SLUG=

# YES buys the first clobTokenIds entry; NO buys the second.
# Use AUTO for threshold markets such as "Bitcoin above $110k".
TRADE_OUTCOME=AUTO
SPOT_PRICE_SOURCE=COINGECKO
CHAINLINK_DATA_STREAMS_API_KEY=
CHAINLINK_DATA_STREAMS_API_SECRET=
CHAINLINK_BTC_USD_FEED_ID=
CHAINLINK_DATA_STREAMS_API_URL=https://api.dataengine.chain.link
MANUAL_BTC_PRICE=
THRESHOLD_BUFFER_BPS=25

# Conservative defaults for testing.
MAX_PRICE=0.55
ORDER_SIZE=5
MAX_DAILY_USD=25
MIN_MARKET_LIQUIDITY=0
MAX_MARKETS_PER_RUN=3

# Market discovery.
MARKET_QUERY=bitcoin btc
MARKET_DIRECTION_QUERY=up down higher lower above below
MARKET_LIMIT=50

# Polymarket CLOB trading settings.
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
SIGNATURE_TYPE=0
PRIVATE_KEY=
FUNDER_ADDRESS=
