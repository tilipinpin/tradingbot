DRY_RUN=true
LIVE_TRADING=false

# Optional: pin a specific Polymarket event/market slug from the URL after /event/.
POLYMARKET_EVENT_SLUG=
POLYMARKET_MARKET_SLUG=

# YES buys the first clobTokenIds entry; NO buys the second.
# Use AUTO for threshold markets such as "Bitcoin above $110k".
TRADE_OUTCOME=AUTO
SPOT_PRICE_SOURCE=COINGECKO
CHAINLINK_DATA_STREAMS_API_KEY=
CHAINLINK_DATA_STREAMS_API_SECRET=
CHAINLINK_BTC_USD_FEED_ID=
CHAINLINK_DATA_STREAMS_API_URL=https://api.dataengine.chain.link
MANUAL_BTC_PRICE=
THRESHOLD_BUFFER_BPS=25

# Conservative defaults for testing.
MAX_PRICE=0.55
ORDER_SIZE=5
MAX_DAILY_USD=25
MIN_MARKET_LIQUIDITY=0
MAX_MARKETS_PER_RUN=3

# Market discovery.
MARKET_QUERY=bitcoin btc
MARKET_DIRECTION_QUERY=up down higher lower above below
MARKET_LIMIT=50

# Polymarket V2 deposit-wallet trading settings.
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
SIGNATURE_TYPE=3
PRIVATE_KEY=
# The deployed deposit wallet, not the owner EOA derived from PRIVATE_KEY.
FUNDER_ADDRESS=
DEPOSIT_WALLET=
RELAYER_URL=https://relayer-v2.polymarket.com
RPC_URL=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Optional Telegram notifications. Keep the bot token only in the local .env file.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEZONE=Asia/Shanghai
TELEGRAM_TIMEOUT=10
TELEGRAM_SETTLEMENT_INTERVAL=30
TELEGRAM_NOTIFY_ON_MATCHED=false
TELEGRAM_COMMANDS_ENABLED=true

# Optional Discord notifications. Discord is notification-only; Telegram remains the control channel.
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Polymarket Trading Bot
DISCORD_TIMEOUT=10

POLYMARKET_POSITIONS_API=https://data-api.polymarket.com/positions
# Persistent matched-order ledger and daily balance snapshots; data/ is gitignored.
TELEGRAM_TRADE_LEDGER=data/live_trade_events.jsonl
TELEGRAM_DAILY_STATE=data/telegram_daily_state.json
